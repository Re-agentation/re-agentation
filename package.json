{
  "name": "re-agentation",
  "version": "0.0.0",
  "private": true,
  "description": "RN dev probe + Metro middleware + MCP server. Tap a component in your iOS/Android simulator, annotate it, and have Claude Code edit the right file. Inspired by Agentation.",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/re-agentation/re-agentation.git"
  },
  "homepage": "https://github.com/re-agentation/re-agentation",
  "bugs": "https://github.com/re-agentation/re-agentation/issues",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='./packages/*' && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
