{
  "name": "re-agentation",
  "version": "0.0.0",
  "private": true,
  "description": "RN dev probe + Metro middleware + MCP server. Tap a component in your iOS/Android simulator, annotate it, and have Claude Code edit the right file. Inspired by Agentation.",
  "license": "MIT",
  "author": "Jaehwa Jung <jhjh7306@gmail.com> (https://www.linkedin.com/in/jaehwajung/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/re-agentation/re-agentation.git"
  },
  "homepage": "https://github.com/re-agentation/re-agentation",
  "bugs": "https://github.com/re-agentation/re-agentation/issues",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='./packages/*' && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^25.9.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.12",
      "metro": "0.81.5",
      "metro-config": "0.81.5",
      "metro-resolver": "0.81.5",
      "metro-runtime": "0.81.5",
      "metro-cache": "0.81.5",
      "metro-cache-key": "0.81.5",
      "metro-core": "0.81.5",
      "metro-source-map": "0.81.5",
      "metro-symbolicate": "0.81.5",
      "metro-transform-worker": "0.81.5",
      "metro-transform-plugins": "0.81.5",
      "metro-babel-transformer": "0.81.5",
      "metro-file-map": "0.81.5",
      "metro-minify-terser": "0.81.5"
    }
  }
}
