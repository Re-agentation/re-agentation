{
  "name": "@re-agentation/probe",
  "version": "0.2.1",
  "description": "React Native dev-only probe overlay — tap a component, annotate it, batch into a single AI edit request. Part of Re-agentation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/re-agentation/re-agentation.git",
    "directory": "packages/probe"
  },
  "homepage": "https://github.com/re-agentation/re-agentation/tree/main/packages/probe",
  "bugs": "https://github.com/re-agentation/re-agentation/issues",
  "keywords": [
    "react-native",
    "dev-tools",
    "ai",
    "claude",
    "mcp",
    "agentation",
    "annotation",
    "inspector"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0",
    "react-native-svg": ">=13.0.0",
    "react-native-image-picker": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-image-picker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "@types/react-native": "^0.73.0",
    "react": "^19.0.0",
    "react-native": "^0.76.0",
    "react-native-image-picker": "^7.2.3",
    "react-native-svg": "^15.0.0",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
