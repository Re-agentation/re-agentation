{
  "name": "@re-agentation/mcp",
  "version": "0.2.1",
  "description": "MCP server that exposes Re-agentation annotation batches to Claude Code / Claude Desktop (stdio) and to Cursor / Windsurf / other clients (HTTP+SSE).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/re-agentation/re-agentation.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/re-agentation/re-agentation/tree/main/packages/mcp",
  "bugs": "https://github.com/re-agentation/re-agentation/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "react-native",
    "agentation"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "re-agentation-mcp": "./dist/server.cjs",
    "re-agentation-mcp-http": "./dist/http-server.cjs",
    "re-agentation-apply": "./dist/apply-watcher.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
